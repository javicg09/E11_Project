# Plantilla de variables de entorno. Copiar a .env (en la raíz del repo) y cambiar las contraseñas.
# El fichero .env lo leen tanto docker compose como el backend. Nunca se versiona.

# --- Backend ---
PORT=3000
NODE_ENV=development

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=e11_encuentros

# Usuario administrador (solo lo usa el contenedor de MongoDB en el primer arranque)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=cambia_esta_contrasena_root

# Usuario de la aplicación (rol readWrite únicamente sobre MONGO_DB_NAME)
MONGO_APP_USER=e11_app
MONGO_APP_PASSWORD=cambia_esta_contrasena_app

# Cadena de conexión que usa el backend. Debe coincidir con los valores anteriores.
# Si la contraseña contiene caracteres especiales (@ : / ? # %), hay que codificarlos en URL.
MONGO_URI=mongodb://e11_app:cambia_esta_contrasena_app@localhost:27017/e11_encuentros?authSource=e11_encuentros
